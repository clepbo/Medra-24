---
title: Institution Admin Journey — "Mr. Bello" (clinic, end to end)
---
flowchart TD
    classDef start fill:#39B0CF,stroke:#1B3A5B,color:#FFFFFF;
    classDef page fill:#F4F6F8,stroke:#B4C4D1,color:#0F2233;
    classDef action fill:#1B3A5B,stroke:#0F2233,color:#FFFFFF;
    classDef decision fill:#FBF1DD,stroke:#E0A32E,color:#0F2233;
    classDef system fill:#E4F0F5,stroke:#2F8BAC,color:#0F2233;
    classDef data fill:#0F2233,stroke:#39B0CF,color:#FFFFFF;
    classDef done fill:#E6F5EE,stroke:#2FA36B,color:#0F2233;

    A([Admin opens Medra<br/>for Business]):::start --> B{Institution<br/>registered?}:::decision

    %% ---- ONBOARDING ----
    B -- No --> R1[Register institution:<br/>name · type · contact]:::page
    R1 --> R2[Upload practice licence<br/>+ documents]:::page
    R2 --> R3[Choose plan by size:<br/>Single-practice ·<br/>Multi-doctor · Multi-branch]:::page
    R3 --> R4[Create admin login]:::page
    R4 --> TRIAL[[30-day free trial starts —<br/>no card required]]:::system
    TRIAL --> WAIT[Pending review:<br/>awaiting Medra approval]:::page
    WAIT --> APR{Medra approves?}:::decision
    APR -- Rejected --> FIX[Reason shown →<br/>fix & resubmit docs]:::page --> WAIT
    APR -- Approved --> DASH
    B -- Yes --> LOG[Log in]:::page --> DASH

    %% ---- DASHBOARD HUB ----
    DASH[🖥️ Admin Dashboard:<br/>bookings · patients · usage ·<br/>trial countdown]:::page --> NAV{{Menu: Bookings · Staff ·<br/>Records · Messages · Branches ·<br/>Billing · Settings}}:::system

    %% ---- STAFF ----
    NAV --> ST1[Staff Management]:::page
    ST1 --> ST2[Add doctor / staff:<br/>name · role · MDCN]:::action
    ST2 --> ST3[[Doctor invited → verified<br/>by Medra → sets availability]]:::system --> ST4{More staff?}:::decision
    ST4 -- Yes --> ST2
    ST4 -- No --> DASH
    ST1 --> ST5[Edit roles & permissions]:::page --> DASH

    %% ---- BOOKINGS / ALLOCATION ----
    NAV --> BK1[Bookings inbox:<br/>new · confirmed · today]:::page
    BK1 --> BK2{New booking<br/>received?}:::decision
    BK2 -- No --> DASH
    BK2 -- Yes --> BK3{Patient requested<br/>a specific doctor?}:::decision
    BK3 -- Yes --> BK4[Assign to requested doctor]:::action
    BK3 -- No --> BK5[Allocate to an<br/>available doctor]:::action
    BK4 --> BK6[[Doctor notified ·<br/>patient notified]]:::system --> BK1
    BK5 --> BK6

    %% ---- RECORDS ----
    NAV --> RC1[Patient Records:<br/>search patient]:::page
    RC1 --> RC2[View record<br/>read-only oversight]:::page --> DASH

    %% ---- MESSAGING ----
    NAV --> MS1[Internal Staff Messaging]:::page
    MS1 --> MS2[Message a doctor /<br/>team channel]:::action --> MS1
    MS1 --> DASH

    %% ---- MULTI-BRANCH ----
    NAV --> BR1[Branches view<br/>enterprise plan]:::page
    BR1 --> BR2[Add / manage a branch<br/>billed as one institution]:::action --> DASH

    %% ---- BILLING ----
    NAV --> BL1[Subscription & Billing:<br/>plan · trial countdown]:::page
    BL1 --> BL2{Trial ending or<br/>expired?}:::decision
    BL2 -- Active --> DASH
    BL2 -- Pay now --> BL3[Pay subscription<br/>Paystack auto-charge]:::action
    BL3 --> BL4[[SMS: payment confirmed ·<br/>account active]]:::system --> DASH
    BL2 -. If unpaid .-> EXP[Subscription expired:<br/>staff dashboards LOCKED<br/>patient side still works]:::page --> BL3

    %% ---- SETTINGS ----
    NAV --> SET[Settings:<br/>edit profile · change password]:::page
    SET --> LO[Log out]:::action --> END([Session ends]):::start
    SET --> DASH

    linkStyle default stroke:#5B6B7A,stroke-width:1.4px;
